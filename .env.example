# Gemini / AI Config
GOOGLE_API_KEY=your_gemini_api_key
GEMINI_MODEL_ID=gemini-3.1-pro

# Security & Auth
ADMIN_EMAIL=your_admin_email@gmail.com
APP_PASSWORD=YourStrongMasterPasswordHere!2026
JWT_SECRET=your_long_random_hmac_secret_key_here

# SMTP Email Dispatch (Option 1)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=YourAppName Security <noreply@yourdomain.com>

# Resend Email Dispatch (Option 2)
# RESEND_API_KEY=re_your_resend_api_key_here
